# ---------------------------------------------------------------------------
# Rela — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Never put
# SUPABASE_SERVICE_ROLE_KEY, FLW_SECRET_KEY or FLW_SECRET_HASH there.
# ---------------------------------------------------------------------------

# Public site URL (used for verification links, redirects, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (Dashboard → Settings → API keys / Webhooks)
NEXT_PUBLIC_FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Plan identifier sent as meta.plan on checkout
FLW_PLAN_CODE=starter_monthly

# Platform owner — the only account allowed into /admin
ADMIN_EMAIL=chimdindundubuisirich@gmail.com

# Public contact details surfaced in the UI
NEXT_PUBLIC_SUPPORT_EMAIL=therelasolutions@gmail.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=2349153230482
